# Public Supabase project URL. Obtain from Supabase Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=

# Public anon/publishable key. Obtain from Supabase Project Settings → API.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical browser URL. Production: https://secret-iota-ten.vercel.app; local: http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Supabase project reference used by CLI/operations, not required by the browser runtime.
SUPABASE_PROJECT_REF=tqzchcbbkwycjhaegmgi

# Optional future integrations. Keep empty until the corresponding provider is enabled.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
